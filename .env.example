# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# All settings use the FXT_ prefix; see src/fxterminal/core/config.py.

# dev | test | prod
FXT_APP_ENV=dev

# Postgres + TimescaleDB (recommended; requires `docker compose up -d` or an
# existing server). Falls back to local SQLite if you leave the default unset.
#FXT_DATABASE_URL=postgresql+asyncpg://fxterminal:fxterminal@localhost:5432/fxterminal
FXT_DATABASE_URL=sqlite+aiosqlite:///./fxterminal.db

# Redis (job queue / cache; only needed once ingestion scheduling is enabled)
FXT_REDIS_URL=redis://localhost:6379/0

# --- LLM backend (Phases 3-4 + chat) ---
# Choose ONE provider. Both are schema-validated; the LLM never does math.
#
# A) Anthropic (default):
#    Get a key at https://console.anthropic.com/ — never put it in code or logs.
#FXT_LLM_PROVIDER=anthropic
#FXT_ANTHROPIC_API_KEY=sk-ant-...
# Model ID — check https://docs.anthropic.com/en/docs/about-claude/models for
# current names; this default may be outdated by the time you read it.
FXT_LLM_MODEL=claude-sonnet-4-5
#
# B) Any OpenAI-compatible endpoint — Groq and OpenRouter have free tiers,
#    Ollama runs fully local (no key needed):
#FXT_LLM_PROVIDER=openai_compat
#FXT_LLM_BASE_URL=https://api.groq.com/openai/v1        # or https://openrouter.ai/api/v1, http://localhost:11434/v1
#FXT_LLM_API_KEY=gsk_...                                 # omit for Ollama
#FXT_LLM_MODEL=llama-3.3-70b-versatile                   # or your provider's model

# Currencies the terminal scores (comma-separated). Central-bank coverage is
# derived via BANK_CURRENCIES in core/config.py: FED/ECB/BOJ/BOE/SNB/RBA/RBNZ.
FXT_CURRENCIES=USD,EUR,JPY,GBP,CHF,NZD,AUD

# Trade-idea risk filters (deterministic, not the LLM)
FXT_MAX_SPREAD_PIPS=3.0
FXT_EVENT_BLACKOUT_HOURS=4
# Ingestion validation: reject a bar whose close jumps >10% vs previous close
FXT_MAX_PRICE_JUMP_PCT=0.10

# Logging: INFO|DEBUG|WARNING, json|console
FXT_LOG_LEVEL=INFO
FXT_LOG_FORMAT=console

# --- Ingestion (Phase 2) ---
# Free FRED key: https://fred.stlouisfed.org/docs/api/api_key.html
#FXT_FRED_API_KEY=...
# Trading Economics calendar — PAID key (guest tier discontinued):
# https://tradingeconomics.com/api/pricing.aspx
#FXT_TE_API_KEY=...
#FXT_FRANKFURTER_BASE_URL=https://api.frankfurter.dev
#FXT_RATE_EXPECTATIONS_FILE=data/rate_expectations.json

# Intraday prices — unofficial Yahoo Finance chart endpoint, no key needed.
# Feeds '1h' bars on the fast tick; Frankfurter stays the official daily fix.
#FXT_INTRADAY_PRICES_ENABLED=true
# Minutes between intraday price refreshes inside `fxterminal serve` (min 1).
#FXT_INTRADAY_INTERVAL_MINUTES=60

# To use the local embedded Postgres started via `make pg-start`:
#FXT_DATABASE_URL=postgresql+asyncpg://postgres@/fxterminal?host=/home/abdimalik/new_era/pgdata

# --- Scheduling + alerts (Phase 8) ---
# Hours between pipeline cycles for `fxterminal serve` (default 24)
#FXT_SCHEDULE_INTERVAL_HOURS=24
# Generic webhook for alerts (Slack/Discord/custom JSON POST); log-only if unset
#FXT_ALERT_WEBHOOK=https://hooks.slack.com/services/...
